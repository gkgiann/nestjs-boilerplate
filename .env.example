# Application
NODE_ENV=development
PORT=3000

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# Database (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/eventgo_db?schema=public"

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars-change-in-production
JWT_REFRESH_EXPIRATION=7d

# Payment Provider (example: Stripe, Mercado Pago)
PAYMENT_PROVIDER_API_KEY=your-payment-provider-api-key
PAYMENT_PROVIDER_WEBHOOK_SECRET=your-webhook-secret
