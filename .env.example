#################################
# Application
#################################

NODE_ENV=development
PORT=3000
APP_NAME=nestjs-boilerplate
APP_VERSION=1.0.0

#################################
# CORS
#################################

CORS_ORIGINS=http://localhost:5173,http://localhost:3001

#################################
# Database (Prisma)
#################################

DATABASE_URL=postgresql://user:password@localhost:5432/boilerplate_db?schema=public

#################################
# JWT Authentication
#################################

JWT_ACCESS_SECRET=your-super-secret-access-key-min-32-chars
JWT_ACCESS_EXPIRATION=15m

JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars
JWT_REFRESH_EXPIRATION=7d

#################################
# Password Security
#################################

BCRYPT_SALT_ROUNDS=10

#################################
# Logging
#################################

LOG_LEVEL=info

#################################
# Rate Limiting
#################################

# Global rate limiting (applies to all endpoints by default)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Auth-specific rate limiting (stricter limits for login/refresh endpoints)
AUTH_THROTTLE_TTL=60
AUTH_THROTTLE_LIMIT=5
